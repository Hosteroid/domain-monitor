{# API Tokens section of the profile page. Included only when the page has something to show (api is set). #}
{% set inputClass = 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary bg-white dark:bg-slate-700 text-gray-900 dark:text-white text-sm' %}
<div id="section-api" class="content-section hidden">
    <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">API Tokens</h3>
            <p class="text-sm text-gray-600 dark:text-slate-400 mt-1">Let a dashboard or a script work with your domains ({{ api.tokens|length }} of {{ api.max }})</p>
        </div>

        <div class="p-6">
            {% if api.new_token %}
            <div class="mb-6 bg-green-50 dark:bg-green-500/10 border border-green-200 dark:border-green-800 rounded-lg p-4">
                <p class="text-sm font-semibold text-green-900 dark:text-green-300">
                    <i class="fas fa-check-circle mr-2"></i>Your new token
                </p>
                <p class="text-xs text-green-800 dark:text-green-400 mt-1">Copy it now. It is not saved anywhere and will not be shown again.</p>
                <div class="flex items-center gap-2 mt-3">
                    <code id="new-api-token" class="flex-1 min-w-0 break-all select-all font-mono text-sm bg-white dark:bg-slate-900 border border-green-200 dark:border-green-800 rounded-lg px-3 py-2 text-gray-900 dark:text-white">{{ api.new_token }}</code>
                    <button type="button" onclick="copyApiToken(this)" class="flex-shrink-0 inline-flex items-center px-3 py-2 bg-green-600 text-white text-xs rounded-lg hover:bg-green-700 transition-colors font-medium">
                        <i class="fas fa-copy mr-1.5"></i><span>Copy</span>
                    </button>
                </div>
            </div>
            {% endif %}

            {% if not api.can_create %}
            <div class="mb-4 bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-800 rounded-lg p-3 text-sm text-amber-900 dark:text-amber-300">
                <i class="fas fa-ban mr-2"></i>
                {{ api.access == 'off' ? 'The API is turned off.' : 'The API is limited to admins.' }}
                Your tokens are refused until that changes. You can still revoke them.
            </div>
            {% endif %}

            {% if api.tokens %}
            <div class="space-y-3">
                {% for token in api.tokens %}
                <div class="flex items-start justify-between p-4 bg-gray-50 dark:bg-slate-700 border border-gray-200 dark:border-slate-600 rounded-lg">
                    <div class="flex items-start space-x-3 flex-1 min-w-0">
                        <div class="w-10 h-10 bg-blue-100 dark:bg-blue-500/20 rounded-lg flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-key text-blue-600 dark:text-blue-400"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center flex-wrap gap-2">
                                <h4 class="text-sm font-semibold text-gray-900 dark:text-white break-all">{{ token.name }}</h4>
                                {% if token.can_write %}
                                <span class="px-2 py-0.5 bg-amber-100 dark:bg-amber-500/10 text-amber-800 dark:text-amber-400 text-xs font-semibold rounded">Read and write</span>
                                {% else %}
                                <span class="px-2 py-0.5 bg-gray-200 dark:bg-slate-600 text-gray-700 dark:text-slate-300 text-xs font-semibold rounded">Read</span>
                                {% endif %}
                                {% if token.expired %}
                                <span class="px-2 py-0.5 bg-red-100 dark:bg-red-500/10 text-red-800 dark:text-red-400 text-xs font-semibold rounded">Expired</span>
                                {% endif %}
                            </div>
                            <p class="text-xs font-mono text-gray-600 dark:text-slate-400 mt-1">dmk_…{{ token.token_hint }}</p>
                            <div class="flex flex-wrap items-center gap-3 text-xs text-gray-400 dark:text-slate-500 mt-1">
                                <span><i class="fas fa-plus mr-1"></i>Created {{ token.created_at|date('M d, Y') }}</span>
                                <span><i class="fas fa-clock mr-1"></i>{% if token.last_used_at %}Last used {{ token.last_used_at|date('M d, Y H:i') }} from {{ token.last_used_ip }}{% else %}Never used{% endif %}</span>
                                <span><i class="fas fa-hourglass-half mr-1"></i>{% if token.expires_at %}{{ token.expired ? 'Expired' : 'Expires' }} {{ token.expires_at|date('M d, Y') }}{% else %}No expiry{% endif %}</span>
                            </div>
                        </div>
                    </div>
                    <form method="POST" action="/profile/delete-api-token/{{ token.id }}" onsubmit="return confirmSubmit(event, 'Revoke this token? Whatever uses it stops working.', { title: 'Revoke Token', icon: 'fa-key text-red-500' })" class="ml-3">
                        {{ csrf_field() }}
                        <button type="submit" class="flex items-center justify-center w-8 h-8 bg-red-100 dark:bg-red-500/20 text-red-600 dark:text-red-400 rounded-lg hover:bg-red-600 hover:text-white dark:hover:bg-red-600 transition-colors" title="Revoke token">
                            <i class="fas fa-times text-sm"></i>
                        </button>
                    </form>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <div class="text-center py-6">
                <i class="fas fa-key text-gray-300 dark:text-slate-600 text-4xl mb-3"></i>
                <p class="text-sm text-gray-600 dark:text-slate-400">No tokens yet</p>
            </div>
            {% endif %}

            {% if api.can_create %}
            <form method="POST" action="/profile/create-api-token" class="pt-6 mt-6 border-t border-gray-200 dark:border-slate-700">
                {{ csrf_field() }}
                <h4 class="text-base font-semibold text-gray-900 dark:text-white mb-4">New token</h4>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="token_name" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Name</label>
                        <input type="text" id="token_name" name="token_name" maxlength="100" required placeholder="Homepage dashboard" autocomplete="off" class="{{ inputClass }}">
                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">Where the token is used, so you know which one to revoke.</p>
                    </div>
                    <div>
                        <label for="token_access" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Access</label>
                        <select id="token_access" name="token_access" class="{{ inputClass }}">
                            <option value="read">Read</option>
                            {% if api.can_write %}
                            <option value="write">Read and write</option>
                            {% endif %}
                        </select>
                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">
                            {% if api.can_write %}
                            Read and write can add, change, delete and refresh domains.
                            {% else %}
                            An admin has not turned on write access.
                            {% endif %}
                        </p>
                    </div>
                    <div>
                        <label for="token_expiry" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Expires</label>
                        <select id="token_expiry" name="token_expiry" class="{{ inputClass }}">
                            {% for value, label in api.expiry_choices %}
                            <option value="{{ value }}">{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div>
                        <label for="token_password" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Your password</label>
                        <input type="password" id="token_password" name="current_password" required autocomplete="current-password" class="{{ inputClass }}">
                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">A token works without your password and 2FA, so creating one asks for it.</p>
                    </div>
                </div>

                <div class="flex items-center justify-end pt-6">
                    <button type="submit" class="inline-flex items-center px-4 py-2.5 bg-primary text-white text-sm rounded-lg hover:bg-primary-dark transition-colors font-medium">
                        <i class="fas fa-plus mr-2"></i>
                        Create Token
                    </button>
                </div>
            </form>

            <div class="bg-blue-50 dark:bg-blue-500/10 border border-blue-200 dark:border-blue-500/20 rounded-lg p-3 mt-4">
                <p class="text-xs text-gray-600 dark:text-slate-400">
                    <i class="fas fa-info-circle text-blue-500 dark:text-blue-400 mr-1"></i>
                    A token sees what you see. Send it in a header, never in the address:
                </p>
                <code class="block mt-2 font-mono text-xs break-all text-gray-800 dark:text-slate-300">curl -H "X-API-Key: YOUR_TOKEN" {{ api.base_url }}/stats</code>
            </div>
            {% endif %}
        </div>
    </div>
</div>

{% if api.new_token %}
<script>
function copyApiToken(button) {
    const token = document.getElementById('new-api-token').textContent.trim();
    const label = button.querySelector('span');
    const done = function () {
        label.textContent = 'Copied';
        setTimeout(function () { label.textContent = 'Copy'; }, 2000);
    };
    // The clipboard API needs HTTPS or localhost. Without it, a hidden text field is copied.
    const fallback = function () {
        const field = document.createElement('textarea');
        field.value = token;
        field.style.position = 'fixed';
        field.style.left = '-999999px';
        document.body.appendChild(field);
        field.select();
        try {
            if (document.execCommand('copy')) {
                done();
            }
        } catch (err) {
            // The token stays selectable by hand
        }
        document.body.removeChild(field);
    };

    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(token).then(done).catch(fallback);
    } else {
        fallback();
    }
}
</script>
{% endif %}
