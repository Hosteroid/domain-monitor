{#
    One payment for each domain selected in the Domains list, for an invoice that covers several domains.
    Needs: base (currency code) and currencies (rows with code). Opens with openBulkPaymentModal().
#}
{% set bulkInput = 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent' %}
{% set bulkLabel = 'block text-sm font-medium text-gray-700 dark:text-slate-300 mb-1.5' %}
<div id="bulkPaymentModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white dark:bg-slate-800 rounded-lg shadow-xl w-full max-w-2xl max-h-full overflow-y-auto">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-700 flex items-center justify-between">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                <i class="fas fa-receipt text-primary mr-2"></i>Add Payment for <span id="bulkPaymentCount">0</span> <span id="bulkPaymentNoun">Domains</span>
            </h3>
            <button type="button" onclick="closeBulkPaymentModal()" class="text-gray-400 dark:text-slate-500 hover:text-gray-600 dark:hover:text-slate-300">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form method="POST" action="/billing/bulk-store" id="bulkPaymentForm">
            {{ csrf_field() }}
            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="bulk_pay_type" class="{{ bulkLabel }}">Type</label>
                    <select id="bulk_pay_type" name="type" class="{{ bulkInput }}" onchange="updateBulkPaymentFields()">
                        <option value="renewal">Renewal</option>
                        <option value="purchase">Purchase</option>
                        <option value="transfer">Transfer</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div>
                    <label for="bulk_pay_date" class="{{ bulkLabel }}">Date</label>
                    <input type="date" id="bulk_pay_date" name="transaction_date" required class="{{ bulkInput }}">
                </div>
                <div>
                    <label for="bulk_pay_amount" class="{{ bulkLabel }}">Amount per Domain</label>
                    <input type="text" id="bulk_pay_amount" name="amount" inputmode="decimal" autocomplete="off" class="{{ bulkInput }}">
                    <p id="bulkPayAmountHint" class="text-xs text-gray-500 dark:text-slate-400 mt-1"></p>
                </div>
                <div>
                    <label for="bulk_pay_currency" class="{{ bulkLabel }}">Currency</label>
                    <select id="bulk_pay_currency" name="currency" class="{{ bulkInput }}">
                        {% for currency in currencies %}
                        <option value="{{ currency.code }}" {{ currency.code == base ? 'selected' : '' }}>{{ currency.code }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div id="bulkPayYearsWrap">
                    <label for="bulk_pay_years" class="{{ bulkLabel }}">Years</label>
                    <input type="number" id="bulk_pay_years" name="term_years" min="1" max="100" step="1" placeholder="1" class="{{ bulkInput }}">
                </div>
                <div>
                    <label for="bulk_pay_vendor" class="{{ bulkLabel }}">Company / Seller</label>
                    <input type="text" id="bulk_pay_vendor" name="vendor" maxlength="255" class="{{ bulkInput }}">
                </div>
                <div>
                    <label for="bulk_pay_invoice" class="{{ bulkLabel }}">Invoice Number</label>
                    <input type="text" id="bulk_pay_invoice" name="invoice_number" maxlength="100" class="{{ bulkInput }}">
                </div>
                <div>
                    <label for="bulk_pay_invoice_url" class="{{ bulkLabel }}">Invoice Link</label>
                    <input type="url" id="bulk_pay_invoice_url" name="invoice_url" maxlength="500" placeholder="https://" class="{{ bulkInput }}">
                </div>
                <div>
                    <label for="bulk_pay_method" class="{{ bulkLabel }}">Payment Method</label>
                    <input type="text" id="bulk_pay_method" name="payment_method" maxlength="100" class="{{ bulkInput }}">
                </div>
                <div>
                    <label for="bulk_pay_notes" class="{{ bulkLabel }}">Notes</label>
                    <input type="text" id="bulk_pay_notes" name="notes" maxlength="2000" class="{{ bulkInput }}">
                </div>
            </div>
            <div class="px-6 py-4 border-t border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900 flex justify-end gap-2 rounded-b-lg">
                <button type="button" onclick="closeBulkPaymentModal()" class="px-4 py-2 border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 rounded-lg text-sm font-medium hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors">
                    <i class="fas fa-save mr-1.5"></i>Save Payments
                </button>
            </div>
        </form>
    </div>
</div>
<script>
function openBulkPaymentModal() {
    var ids = getSelectedIds();
    if (!ids.length) { return; }
    var form = document.getElementById('bulkPaymentForm');
    form.querySelectorAll('input[name="domain_ids[]"]').forEach(function (input) { input.remove(); });
    ids.forEach(function (id) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'domain_ids[]';
        input.value = id;
        form.appendChild(input);
    });
    document.getElementById('bulkPaymentCount').textContent = ids.length;
    document.getElementById('bulkPaymentNoun').textContent = ids.length === 1 ? 'Domain' : 'Domains';
    if (!form.elements.transaction_date.value) {
        form.elements.transaction_date.value = new Date().toLocaleDateString('en-CA');
    }
    updateBulkPaymentFields();
    document.getElementById('bulkPaymentModal').classList.remove('hidden');
}

function closeBulkPaymentModal() {
    document.getElementById('bulkPaymentModal').classList.add('hidden');
}

// A renewal can take each domain's expected price. Everything else needs the amount.
function updateBulkPaymentFields() {
    var form = document.getElementById('bulkPaymentForm');
    var type = form.elements.type.value;
    var renewal = type === 'renewal';
    form.elements.amount.required = !renewal;
    form.elements.amount.placeholder = renewal ? 'Expected price of each domain' : '14.99';
    document.getElementById('bulkPayAmountHint').textContent = renewal
        ? 'Leave empty to use the expected price of each domain. Domains without a price are skipped.'
        : 'The same amount is saved for each domain.';
    document.getElementById('bulkPayYearsWrap').classList.toggle('hidden', !renewal && type !== 'transfer');
}

document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeBulkPaymentModal(); }
});
</script>
