{# Billing tab of the Settings page: switches, base currency and the currencies with their rates #}
{% set inputClass = 'w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm focus:ring-2 focus:ring-primary focus:border-primary bg-white dark:bg-slate-700 text-gray-900 dark:text-white' %}
{% set checkClass = 'w-4 h-4 mt-0.5 text-primary border-gray-300 dark:border-slate-600 rounded focus:ring-primary cursor-pointer' %}
<div id="content-billing" class="tab-content hidden">
    <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-900">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Billing Settings</h3>
            <p class="text-sm text-gray-600 dark:text-slate-400 mt-1">Payments, the price list and renewal forecasts</p>
        </div>

        {% if not billing.available %}
        <div class="p-6">
            <div class="bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-800 rounded-lg p-4 text-sm text-amber-900 dark:text-amber-300">
                <i class="fas fa-database mr-2"></i>
                Billing needs a database update first.
                <a href="/install/update" class="underline font-medium">Run the update</a>
            </div>
        </div>
        {% else %}
        <form method="POST" action="/settings/update-billing" class="p-6">
            {{ csrf_field() }}

            <div class="mb-6">
                <h4 class="text-base font-semibold text-gray-900 dark:text-white mb-2 flex items-center">
                    <i class="fas fa-wallet text-primary mr-2"></i>
                    Billing
                </h4>
                <p class="text-sm text-gray-600 dark:text-slate-400 mb-4">Tracks what each domain costs: purchases, renewals and sales, a price list, and what the next renewals will cost.</p>

                <label class="flex items-start cursor-pointer mb-4">
                    <input type="checkbox" name="billing_enabled" value="1" {{ settings.billing_enabled|default('1') == '1' ? 'checked' : '' }} class="{{ checkClass }}">
                    <div class="ml-3">
                        <span class="text-sm font-medium text-gray-900 dark:text-white">Turn billing on</span>
                        <p class="text-xs text-gray-600 dark:text-slate-400 mt-1">Off hides the Billing page, the Billing tab of a domain, the cost columns and the dashboard card. Saved payments and prices stay.</p>
                    </div>
                </label>

                <label class="flex items-start cursor-pointer mb-4">
                    <input type="checkbox" name="billing_auto_log_renewals" value="1" {{ settings.billing_auto_log_renewals|default('1') == '1' ? 'checked' : '' }} class="{{ checkClass }}">
                    <div class="ml-3">
                        <span class="text-sm font-medium text-gray-900 dark:text-white">Log a payment when a domain is renewed</span>
                        <p class="text-xs text-gray-600 dark:text-slate-400 mt-1">When a check finds a later expiry date, the renewal is added with the expected price and waits for you to confirm it. Domains without a price and without payments are left alone.</p>
                    </div>
                </label>

                <label class="flex items-start cursor-pointer">
                    <input type="checkbox" name="billing_cost_in_reminders" value="1" {{ settings.billing_cost_in_reminders|default('1') == '1' ? 'checked' : '' }} class="{{ checkClass }}">
                    <div class="ml-3">
                        <span class="text-sm font-medium text-gray-900 dark:text-white">Show the renewal cost in expiry reminders</span>
                        <p class="text-xs text-gray-600 dark:text-slate-400 mt-1">Adds a "Renewal cost" line when a price is known for the domain.</p>
                    </div>
                </label>
            </div>

            <div class="border-t border-gray-200 dark:border-slate-700 my-6"></div>

            <div class="mb-6">
                <h4 class="text-base font-semibold text-gray-900 dark:text-white mb-2 flex items-center">
                    <i class="fas fa-coins text-primary mr-2"></i>
                    Base Currency
                </h4>
                <p class="text-sm text-gray-600 dark:text-slate-400 mb-4">Every total and chart is in this currency. A payment in another currency keeps its own amount and stores its value in this one.</p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="billing_currency" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Currency Code</label>
                        <input type="text" id="billing_currency" name="billing_currency" value="{{ billing.base }}" maxlength="3" required
                               {{ billing.locked ? 'readonly' : '' }} placeholder="USD" class="{{ inputClass }} uppercase">
                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">
                            {% if billing.locked %}
                                Locked while payments exist. To change it: export the payments, delete them, change it here, and import them again.
                            {% else %}
                                Three letters, such as USD or EUR. It is locked once the first payment is saved.
                            {% endif %}
                        </p>
                    </div>
                    <div>
                        <label for="billing_currency_symbol" class="block text-sm font-medium text-gray-700 dark:text-slate-300 mb-2">Symbol</label>
                        <input type="text" id="billing_currency_symbol" name="billing_currency_symbol" maxlength="8" placeholder="$"
                               value="{% for currency in billing.currencies %}{% if currency.code == billing.base %}{{ currency.symbol }}{% endif %}{% endfor %}" class="{{ inputClass }}">
                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">Shown in front of amounts. Leave empty to show the code behind them.</p>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-gray-200 dark:border-slate-700">
                <button type="submit" class="inline-flex items-center px-4 py-2.5 bg-primary text-white text-sm rounded-lg hover:bg-primary-dark transition-colors font-medium">
                    <i class="fas fa-save mr-2"></i>
                    Save Billing Settings
                </button>
            </div>
        </form>

        <div class="px-6 pb-6">
            <div class="border-t border-gray-200 dark:border-slate-700 mb-6"></div>
            <h4 class="text-base font-semibold text-gray-900 dark:text-white mb-2 flex items-center">
                <i class="fas fa-exchange-alt text-primary mr-2"></i>
                Other Currencies
            </h4>
            <p class="text-sm text-gray-600 dark:text-slate-400 mb-4">The rate is the value of one unit in {{ billing.base }}. It fills in the {{ billing.base }} value of a new payment. Changing it later leaves saved payments as they are.</p>

            <div class="space-y-2">
                {% for currency in billing.currencies %}
                {% if currency.code != billing.base %}
                <div class="flex flex-wrap items-end gap-2">
                    <form method="POST" action="/settings/billing/currency" class="flex flex-wrap items-end gap-2">
                        {{ csrf_field() }}
                        <input type="hidden" name="code" value="{{ currency.code }}">
                        <div class="w-20">
                            <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Code</label>
                            <div class="px-3 py-2 text-sm font-mono font-semibold text-gray-900 dark:text-white">{{ currency.code }}</div>
                        </div>
                        <div class="w-24">
                            <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Symbol</label>
                            <input type="text" name="symbol" value="{{ currency.symbol }}" maxlength="8" class="{{ inputClass }}">
                        </div>
                        <div class="w-40">
                            <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">1 {{ currency.code }} in {{ billing.base }}</label>
                            <input type="text" name="rate" value="{{ currency.rate|trim('0', 'right')|trim('.', 'right') }}" inputmode="decimal" required class="{{ inputClass }}">
                        </div>
                        <button type="submit" class="px-3 py-2 border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 rounded-lg hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors text-sm font-medium">
                            <i class="fas fa-save mr-1"></i>Save
                        </button>
                    </form>
                    <form method="POST" action="/settings/billing/currency/delete" onsubmit="return confirmSubmit(event, 'Remove this currency?')">
                        {{ csrf_field() }}
                        <input type="hidden" name="code" value="{{ currency.code }}">
                        <button type="submit" class="px-3 py-2 border border-red-300 dark:border-red-800 text-red-700 dark:text-red-400 rounded-lg hover:bg-red-50 dark:hover:bg-red-500/10 transition-colors text-sm font-medium" title="Remove {{ currency.code }}">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                </div>
                {% endif %}
                {% endfor %}
            </div>

            <form method="POST" action="/settings/billing/currency" class="flex flex-wrap items-end gap-2 mt-4 pt-4 border-t border-dashed border-gray-200 dark:border-slate-700">
                {{ csrf_field() }}
                <div class="w-20">
                    <label for="new_currency_code" class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Code</label>
                    <input type="text" id="new_currency_code" name="code" maxlength="3" required placeholder="EUR" class="{{ inputClass }} uppercase">
                </div>
                <div class="w-24">
                    <label for="new_currency_symbol" class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Symbol</label>
                    <input type="text" id="new_currency_symbol" name="symbol" maxlength="8" placeholder="€" class="{{ inputClass }}">
                </div>
                <div class="w-40">
                    <label for="new_currency_rate" class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">1 unit in {{ billing.base }}</label>
                    <input type="text" id="new_currency_rate" name="rate" inputmode="decimal" required placeholder="1.08" class="{{ inputClass }}">
                </div>
                <button type="submit" class="px-3 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium">
                    <i class="fas fa-plus mr-1"></i>Add Currency
                </button>
            </form>
        </div>
        {% endif %}
    </div>
</div>
